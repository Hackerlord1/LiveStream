# Copy to server/.env and fill in. Never commit server/.env.

# Portal (Stalker/MAG). Base URL without /c/ or trailing slash.
IPTV_PORTAL_URL=http://3tv.pro
IPTV_MAC=00:1A:79:XX:XX:XX
# API path on the portal; portal.php works for 3tv.pro (some portals use server/load.php)
IPTV_API_PATH=portal.php

PORT=3477
MAX_ACTIVE_STREAMS=20
# Live TV is re-encoded by default (reliable playback). "copy" uses far less CPU but
# copied channels start slower and can freeze when the provider reconnects.
# LIVE_VIDEO_MODE=copy
MAX_RADIO_PROXIES=50
# Concurrent movie/episode streams (each uses upload bandwidth; MKV movies also run ffmpeg)
MAX_VOD_SESSIONS=10
# Only needed if ffmpeg/ffprobe aren't on PATH
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# How often channels/radio/movies/series are re-downloaded from the portal
CATALOGUE_REFRESH_HOURS=6
# Set to a long random string to enable /debug/* endpoints (?token=...)
DEBUG_TOKEN=
